		NAV_CTRL {
			display-name = "Nav Ctrl";
     bindings = <
// ╭━━━━━━━━━━━━━━━━━━━┬━━━━━━━━━━━━━━━━━━━┬━━━━ Left-side ━━━━┬━━━━━━━━━━━━━━━━━━━┬━━━━━━━━━━━━━━━━━━━╮   ╭━━━━━━━━━━━━━━━━━━━┬━━━━━━━━━━━━━━━━━━━┬━━━ Right-side ━━━━┬━━━━━━━━━━━━━━━━━━━┬━━━━━━━━━━━━━━━━━━━╮
    &kp DELETE		    &trans			    &trans			    &trans			    &trans			        &trans	  	    	&trans	    	    &trans		        &trans              &trans
// ┣━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫
    &mo NAV_SHFT        &kp ESCAPE          &trans         		&mo NAV_CTRL     	&kp TAB  		        &kp LC(LEFT)  	    &kp LC(DOWN)      	&kp LC(UP)          &kp LC(RIGHT)       &sl SYSTEM
