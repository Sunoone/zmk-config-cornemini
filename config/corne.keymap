    &kp RETURN          &kp N7      	    &kp N8  		    &kp N9  			&none         	        &m_dot  	        &none             	&none               &none               &kp SPACE
// ┗━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━╊━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫   ┗━━━━━━━━━━━━━━━━━━━╊━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┫
					    			        &trans  		    &trans         	    &trans                  &trans              &trans 	            &trans
