    &kp PSCRN           &none	            &none	  	&kp PSCRN      	    &kp none	            &mmv MOVE_LEFT	&mmv MOVE_DOWN	    &mmv MOVE_UP	&mmv MOVE_RIGHT     &kp K_VOL_UP
// ┣━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫
    &none               &none	            &trans		&none          	    &none		    &msc SCRL_LEFT	&msc SCRL_DOWN	    &msc SCRL_UP	&msc SCRL_RIGHT	    &kp K_VOL_DN
// ┗━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━╊━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫   ┗━━━━━━━━━━━━━━━━━━━╊━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┫
					    &bt BT_CLR		&trans         	    &to MAIN                &mkp MB1		&mkp MB2	    &mkp MB3 
//      			           ┗━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┛   ┗━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┛
			>;
		};
    };
};
