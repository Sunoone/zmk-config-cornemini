#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define MAIN 0
#define CODE 1
#define MATH 2
#define NAVIGATION 3
#define MEDIA 4
#define TBD 5

&caps_word {
	continue-list = <UNDERSCORE MINUS BSPC DEL SPACE RET TAB>;
};

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };
	
    behaviors {	
		// Tap: Backspace
		// Shift-tap: -
		// Double-tap: -
		// Morph: with Shift => Forward delete ('⌦')
		bspcdel: backspace_or_del {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&kp BSPC>, <&kp DEL>;
			mods = <(MOD_LSFT|MOD_RSFT)>;
		};
		
		// Tap: Dot ('.')
		// Shift-tap: -
		// Double-tap: -
		// Hold: -
		// Morph: with Shift => Comma (',')
		dotcomma: dot_or_comma {
			compatible = "zmk,behavior-mod-morph";
			#binding-cells = <0>;
			bindings = <&kp DOT>, <&kp COMMA>;
			mods = <(MOD_LSFT|MOD_RSFT)>;
		};
		
		// Tap: Sticky Left Shift
		// Shift-tap: -
		// Double-tap: Turn on CAPS_WORD
		// Hold: -
		// Morph: -
		shiftcaps: sticky_shift_or_capsword {
			compatible = "zmk,behavior-tap-dance";
			#binding-cells = <0>;
			tapping-term-ms = <200>;
			bindings = <&sk RSHFT>, <&caps_word>;
		};
    };
	
	conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <CODE MATH>;
            then-layer = <NAVIGATION>;
        };
    };
	
    keymap {
        compatible = "zmk,keymap";

                
		// Layer: MAIN
		// ╭────────────── Left-side ──────────────╮       	╭───────────── Right-side ──────────────╮
		// ┃  qQ   ┃  wW   ┃  eE   ┃  rR   ┃  tT   ┃       	┃  yY   ┃  uU   ┃  iI   ┃  oO   ┃  pP   ┃
		// ┣━━━━━━━╊━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫       	┣━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫
		// ┃  aA   ┃  sS   ┃  dD   ┃  fF   ┃  gG   ┃  		┃  ;:   ┃  hH   ┃  jJ   ┃  kK   ┃  lL   ┃
		// ┣───────╊━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫		┣━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫
		// ┃  zZ   ┃  xX   ┃  cC   ┃  vV   ┃  bB   ┃		┃REMOVE ┃  nN   ┃  mM   ┃  .,   ┃ RSHFT ┃ 
		// ┗━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛		┗━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛
		// 				      ┌───────┬───────┬───────┐	 ┌───────┬───────┬───────┐
		// 				      │ LSHFT |  ESC  | SPACE |	 | ENTER | RCTRL | RALT  |
		// 				      │       |       | MATH  |	 | CODE  |       |       |
		// 				      ╰───────┴───────┴───────┘	 └───────┴───────┴───────╯
		MAIN {
			display-name = "Main";
			bindings = <
				&kp Q			&kp W			&kp E			&kp R			&kp T						&kp Y			&kp U			&kp I			&kp O			&kp P
				&kp A			&kp S			&kp D			&kp F			&kp G						&kp SEMI		&kp H			&kp J			&kp K			&kp L    
				&kp Z			&kp X			&kp C			&kp V			&kp B						&bspcdel		&kp N			&kp M			&dotcomma		&shiftcaps
												&sk LSHFT		&kp ESC			&lt MATH SPACE				&lt CODE RET	&sk RCTRL		&sk RALT
			>;
		};
		
		// Layer: CODE
		// ╭────────────── Left-side ──────────────╮       	╭────────────── Right-side ─────────────╮
		// ┃  F5   ┃   &   ┃   *   ┃   +   ┃   $   ┃       	┃  [{   ┃   {   ┃   '   ┃   }   ┃  ]}   ┃
		// ┣━━━━━━━╊━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫       	┣━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫
		// ┃  =+   ┃  \|   ┃   /   ┃  -_   ┃   !   ┃  		┃   :   ┃   (   ┃   "   ┃   )   ┃  =+   ┃
		// ┣───────╊━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫		┣━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫
		// ┃   #   ┃   %   ┃  .<   ┃  ,>   ┃   ?   ┃		┃REMOVE ┃   <   ┃  `~   ┃   >   ┃ RSHFT ┃ 
		// ┗━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛		┗━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛
		// 				      ┌───────┬───────┬───────┐	 ┌───────┬───────┬───────┐
		// 				      │ LSHFT |  TAB  | SPACE |	 | [   ] | RCTRL | RALT  |
		// 				      │       |       | MATH  |	 |       |       |       |
		// 				      ╰───────┴───────┴───────┘	 └───────┴───────┴───────╯
		CODE {
			display-name = "Coding...";
			bindings = <
				&kp F5			&kp AMPS		&kp ASTRK		&kp PLUS		&kp DLLR					&kp LBKT		&kp LBRC		&kp SQT			&kp RBRC		&kp RBKT
				&kp EQUAL		&kp BSLH		&kp FSLH		&kp MINUS		&kp EXCL    				&kp COLON		&kp LPAR		&kp DQT			&kp RPAR		&kp EQUAL
				&kp AT			&kp HASH		&kp DOT			&kp COMMA		&kp QMARK					&bspcdel		&kp LT			&kp GRAVE		&kp GT			&shiftcaps
												&sk LSHFT		&kp TAB			&trans						&trans			&sk RCTRL		&sk RALT 
			>;
		};

		// Layer: MATH
		// ╭────────────── Left-side ──────────────╮       	╭────────────── Right-side ─────────────╮
		// ┃  F5   ┃   &   ┃   *   ┃   +   ┃   ^   ┃       	┃  [{   ┃  1!   ┃  2@   ┃  3$   ┃  ] }  ┃
		// ┣━━━━━━━╊━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫       	┣━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫
		// ┃  =+   ┃   |   ┃   /   ┃  -_   ┃   !   ┃  		┃  ;:   ┃  4$   ┃  5%   ┃  6^   ┃  0)   ┃
		// ┣───────╊━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫		┣━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫
		// ┃   ~   ┃   %   ┃   <   ┃   >   ┃   .   ┃		┃REMOVE ┃  7&   ┃  8*   ┃  9(   ┃ RSHFT ┃
		// ┗━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛		┗━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛
		// 				      ┌───────┬───────┬───────┐	 ┌───────┬───────┬───────┐
		// 				      │ LSHFT |  ESC  | [   ] |	 | SPACE |  TAB  | RALT  |
		// 				      │       |       |       |	 | CODE  |       |       |
		// 				      ╰───────┴───────┴───────┘	 └───────┴───────┴───────╯
		MATH {
			display-name = "Mathing...";
			bindings = <
				&kp F5			&kp AMPS		&kp ASTRK		&kp PLUS		&kp CARET					&kp RPAR		&kp N1			&kp N2			&kp N3			&trans
				&kp EQUAL		&kp PIPE		&kp FSLH		&kp MINUS		&kp EXCL					&kp SEMI		&kp N4			&kp N5			&kp N6			&kp N0
				&kp TILDE		&kp PRCNT		&kp LT			&kp GT			&kp DOT						&bspcdel		&kp N7			&kp N8			&kp N9			&shiftcaps 
												&sk LSHFT		&kp ESC			&trans						&trans			&kp TAB			&kp RALT
			>;
		};

		// Layer: NAVIGATION
		// ╭────────────── Left-side ──────────────╮       	╭────────────── Right-side ─────────────╮
		// ┃ MEDIA ┃   W   ┃   E   ┃   R   ┃       ┃       	┃   Y   ┃ HOME  ┃  END  ┃ PG DN ┃ PG UP ┃
		// ┣━━━━━━━╊━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫       	┣━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫
		// ┃  TBD  ┃   S   ┃  F4   ┃  F11  ┃ LWIN  ┃  		┃  TAB  ┃   ←   ┃   ↓   ┃   ↑   ┃   →   ┃
		// ┣───────╊━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫		┣━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫
		// ┃   Z   ┃   X   ┃   C   ┃   V   ┃ LSHFT ┃		┃REMOVE ┃ RCTRL ┃  RALT ┃ META  ┃ RSHFT ┃ 
		// ┗━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛		┗━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛
		// 				      ┌───────┬───────┬───────┐	 ┌───────┬───────┬───────┐
		// 				      │ LSHFT |  ESC  | [   ] |	 | [   ] | RCTRL | RALT  |
		// 				      │       |       |       |	 |       |       |       |
		// 				      ╰───────┴───────┴───────┘	 └───────┴───────┴───────╯
		NAVIGATION {
			display-name = "Navigating...";
			bindings = <
				&mo MEDIA		&kp W			&kp E			&kp R			&none						&kp Y			&kp HOME		&kp END			&kp PG_DN		&kp PG_UP
				&none			&kp S			&kp F4			&kp F11			&kp LGUI					&kp TAB			&kp LEFT		&kp DOWN		&kp UP			&kp RIGHT
				&kp Z			&kp X			&kp C			&kp V			&sk LSHFT					&bspcdel		&sk RCTRL		&sk RALT		&kp RMETA		&shiftcaps
												&sk LSHFT		&kp ESC			&trans						&trans			&sk RCTRL		&sk RALT		
			>;
		};
		
		// Layer: MEDIA
		// ╭────────────── Left-side ──────────────╮       	╭────────────── Right-side ─────────────╮
		// ┃ [   ] ┃BT CLR ┃       ┃ PREV  ┃VOL DN ┃       	┃VOL UP ┃ NEXT  ┃       ┃       ┃ STOP  ┃
		// ┣━━━━━━━╊━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫       	┣━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫
		// ┃BT ALL ┃       ┃  RW   ┃ PAUSE ┃ MUTE  ┃  		┃       ┃ PLAY  ┃  FF   ┃       ┃       ┃
		// ┣───────╊━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫		┣━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫
		// ┃       ┃       ┃       ┃       ┃       ┃		┃  BT1  ┃  BT1  ┃  BT3  ┃  BT4  ┃  BT5  ┃ 
		// ┗━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛		┗━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛
		// 				      ┌───────┬───────┬───────┐	 ┌───────┬───────┬───────┐
		// 				      │       |       | [   ] |	 | [   ] |       |       |
		// 				      │       |       |       |	 |       |       |       |
		// 				      ╰───────┴───────┴───────┘	 └───────┴───────┴───────╯				    
		MEDIA {
			display-name = "Consuming media...";
			bindings = <
				&trans			&bt BT_CLR		&none			&kp R			&kp C_VOL_DN				&kp C_VOL_UP	&kp HOME		&none			&none			&kp C_STOP
				&bt BT_CLR_ALL	&none			&kp C_RW		&kp C_PAUSE		&kp C_MUTE					&none			&kp C_PLAY		&kp C_FF		&none			&none
				&none			&none			&none			&none			&none						&bt BT_SEL 0	&bt BT_SEL 1	&bt BT_SEL 2	&bt BT_SEL 3	&bt BT_SEL 4
												&none			&none			&trans						&trans			&none			&none
			>;
		};
		
		// Layer: TBD
		// ╭────────────── Left-side ──────────────╮       	╭────────────── Right-side ─────────────╮
		// ┃       ┃       ┃       ┃       ┃       ┃       	┃       ┃       ┃       ┃       ┃       ┃
		// ┣━━━━━━━╊━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫       	┣━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫
		// ┃ [   ] ┃       ┃       ┃       ┃       ┃  		┃       ┃       ┃       ┃       ┃       ┃
		// ┣───────╊━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫		┣━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━┫
		// ┃       ┃       ┃       ┃       ┃       ┃		┃       ┃       ┃       ┃       ┃       ┃ 
		// ┗━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛		┗━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛
		// 				      ┌───────┬───────┬───────┐	 ┌───────┬───────┬───────┐
		// 				      │ LCTRL | [   ] |       |	 | RSHFT | [   ] | BSPC  |
		// 				      │       |       |       |	 |       |       |       |
		// 				      ╰───────┴───────┴───────┘	 └───────┴───────┴───────╯			    
		TBD {
			status = "reserved";
		};
    };
};