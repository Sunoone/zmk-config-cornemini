#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define MAIN 0

#define HME 1
#define HMN 2

#define UTI 3

#define SYM 4
#define NUM 5

#define NAV 6
#define BTUTI 7
#define GAME 8

#define KEY_E 3
#define KEY_R 4
#define KEY_T 5
#define KEY_A 11
#define KEY_S 12
#define KEY_D 13
#define KEY_F 14
#define KEY_G 15
#define KEY_H 16
#define KEY_J 17
#define KEY_K 18
#define KEY_L 19


&caps_word {
	continue-list = <UNDERSCORE MINUS BSPC DEL SPACE RET TAB>;
};

/ {
    macros {
        hmlk: homerow_mod_layer_kp {
        compatible = "zmk,behavior-macro-two-param";
        #binding-cells = <2>; // Param 1: Layer, Param 2: Modifier
        wait-ms = <0>;
        tap-ms = <0>;
        bindings
            = <&macro_param_1to1 &tog 1>      // Toggles Layer (Param 1)
            , <&macro_param_2to1 &kp 2>;       // Presses Modifier (Param 2)
        };
        hmlm: homerow_mod_layer_mo {
        compatible = "zmk,behavior-macro-two-param";
        #binding-cells = <2>; // Param 1: Layer, Param 2: Modifier
        wait-ms = <0>;
        tap-ms = <0>;
        bindings
            = <&macro_param_1to1 &tog 1>      // Toggles Layer (Param 1)
            , <&macro_param_2to1 &mo 2>;       // Presses Modifier (Param 2)
        };
    };

    combos {
        compatible = "zmk,combos";
        // Activate LALT + HME
        combo_layer_lalt_left {
            layers = <MAIN>;
            key-positions = <KEYS_A KEYS_D KEYS_H>;
            bindings = <&hmlk HME LALT>;
        };
        combo_layer_lalt_down {
            layers = <MAIN>;
            key-positions = <KEYS_A KEYS_D KEYS_J>;
            bindings = <&hmlk HME LALT>;
        };
        combo_layer_lalt_up {
            layers = <MAIN>;
            key-positions = <KEYS_A KEYS_D KEYS_K>;
            bindings = <&hmlk HME LALT>;
        };
        combo_layer_lalt_right {
            layers = <MAIN>;
            key-positions = <KEYS_A KEYS_D KEYS_L>;
            bindings = <&hmlk HME LALT>;
        };
        // Activate LCTRL + HME
        combo_layer_lctl_left {
            layers = <MAIN>;
            key-positions = <KEYS_A KEYS_F KEYS_H>;
            bindings = <&hmlk HME LCTRL>;
        };
        combo_layer_lctl_down {
            layers = <MAIN>;
            key-positions = <KEYS_A KEYS_F KEYS_J>;
            bindings = <&hmlk HME LCTRL>;
        };
        combo_layer_lctl_up {
            layers = <MAIN>;
            key-positions = <KEYS_A KEYS_F KEYS_K>;
            bindings = <&hmlk HME LCTRL>;
        };
        combo_layer_lctl_right {
            layers = <MAIN>;
            key-positions = <KEYS_A KEYS_F KEYS_L>;
            bindings = <&hmlk HME LCTRL>;
        };
        // Activate HMN
        combo_layer_g_left {
            layers = <MAIN>;
            key-positions = <KEYS_A KEYS_F KEYS_H>;
            bindings = <&hmlm HME LCTRL>;
        };
        combo_layer_g_down {
            layers = <MAIN>;
            key-positions = <KEYS_A KEYS_F KEYS_J>;
            bindings = <&hmlm HME LCTRL>;
        };
        combo_layer_g_up {
            layers = <MAIN>;
            key-positions = <KEYS_A KEYS_F KEYS_K>;
            bindings = <&hmlm HME LCTRL>;
        };
        combo_layer_g_right {
            layers = <MAIN>;
            key-positions = <KEYS_A KEYS_F KEYS_L>;
            bindings = <&hmlm HME LCTRL>;
        };
        // Activate HME -> Tab
        combo_layer_tab {
            layers = <MAIN>;
            key-positions = <KEYS_A KEYS_E KEYS_R>;
            bindings = <&to HME>;
        };
    };

    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    behaviors {
		m: morph {
            compatible = "zmk,behavior-macro";
            #binding-cells = <3>; // Accepts 3 parameters: tap_binding, hold_binding, mods
            bindings = <&kp>;
            // Example implementation:  bindings = <&m GT RPAR (MOD_LSFT|MOD_RSFT)>;
            // MSFT macro defined:
        };
    };

    keymap {
        compatible = "zmk,keymap";

// ################################################################################################## MAIN ####################################################################################################
		MAIN {
            display-name = "Main";
            bindings = <
// ╭━━━━━━━━━━━━━━━━━━━┬━━━━━━━━━━━━━━━━━━━┬━━━━ Left-side ━━━━┬━━━━━━━━━━━━━━━━━━━┬━━━━━━━━━━━━━━━━━━━╮   ╭━━━━━━━━━━━━━━━━━━━┬━━━━━━━━━━━━━━━━━━━┬━━━ Right-side ━━━━┬━━━━━━━━━━━━━━━━━━━┬━━━━━━━━━━━━━━━━━━━╮
    &kp Q			    &kp W			    &kp E		    	&kp R			    &kp T				    &kp Y	  		    &kp U	    	    &kp I			    &kp O		  	    &kp P
// ┣━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫
    &kp A			    &kp D               &kp D               &kp F 		        &kp G              	    &kp H   		    &kp J	        	&hm K RCTRL	  	    &hm   LALT          &kp Z
// ┣━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫
    &kp MINUS           &kp X			    &kp C			    &kp V			    &m FSLH BSLH MSFT  	    &m DOT COMMA MSFT	&kp N	        	&kp M			    &kp B	    	    &kp SEMI
// ┗━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━╊━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫   ┗━━━━━━━━━━━━━━━━━━━╊━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┫
								            &none   		    &sk LSHFT   	    &lt NAV SPACE		    &to SYMBOLS 	    &none               &kp LALT
//      			                       ┗━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┛   ┗━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┛
			>;
		};

// ######################################################################################### HME: HOMEROW MOD EDITOR ###########################################################################################
		HME {
			display-name = "HM Edi";
			bindings = <
// ╭━━━━━━━━━━━━━━━━━━━┬━━━━━━━━━━━━━━━━━━━┬━━━━ Left-side ━━━━┬━━━━━━━━━━━━━━━━━━━┬━━━━━━━━━━━━━━━━━━━╮   ╭━━━━━━━━━━━━━━━━━━━┬━━━━━━━━━━━━━━━━━━━┬━━━ Right-side ━━━━┬━━━━━━━━━━━━━━━━━━━┬━━━━━━━━━━━━━━━━━━━╮
    &trans			    &trans			    &mt LWIN E			&trans  			&mt T TAB		        &trans	  	    	 &trans	    	     &trans      		 &trans      		 &trans
// ┣━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫
    &lt MAIN A		    &trans  	        &mt LALT D     		&mt LCTRL F 	    &lt HME G  		        &kp LEFT		     &kp DOWN            &kp UP      		 &kp RIGHT           &trans
// ┣━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫
    &trans              &trans			    &trans			    &trans			    &trans      	        &trans  		     &trans	        	 &trans      		 &trans      	     &trans
// ┗━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━╊━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫   ┗━━━━━━━━━━━━━━━━━━━╊━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┫
					    			        &trans  		    &trans         	    &kp LSHFT               &trans      	    &trans 	            &trans
//      			                       ┗━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┛   ┗━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┛
			>;

// ######################################################################################### HME: HOMEROW MOD NAVIGATION ###########################################################################################
		HMN {
			display-name = "HM Nav";
			bindings = <
// ╭━━━━━━━━━━━━━━━━━━━┬━━━━━━━━━━━━━━━━━━━┬━━━━ Left-side ━━━━┬━━━━━━━━━━━━━━━━━━━┬━━━━━━━━━━━━━━━━━━━╮   ╭━━━━━━━━━━━━━━━━━━━┬━━━━━━━━━━━━━━━━━━━┬━━━ Right-side ━━━━┬━━━━━━━━━━━━━━━━━━━┬━━━━━━━━━━━━━━━━━━━╮
    &trans			    &trans			    &trans			    &trans			    &trans			        &trans	  	    	 &trans	    	     &trans      		 &trans      		 &trans
// ┣━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫
    &trans			    &trans  	        &trans     		    &trans  		    &trans  		        &kp HOME		     &kp PG_DN           &kp PG_UP      	 &kp END             &trans
// ┣━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫   ┣━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫
    &trans              &trans			    &trans			    &trans			    &trans      	        &dotcomma		     &trans	        	 &trans      		 &trans      	     &trans
// ┗━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━╊━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┫   ┗━━━━━━━━━━━━━━━━━━━╊━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┫
					    			        &trans  		    &trans         	    &trans                  &trans      	    &trans 	            &trans
//      			                       ┗━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┛   ┗━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━┛
			>;

// ################################################################################################# ONE TOUCH ###########################################################################################

};
